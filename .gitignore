# ==============================================================================
# 🦀 Rust / Cargo Build Artifacts
# ==============================================================================
# Matches root target/ and any crates/*/target/.
target/

# Per-crate Cargo.lock files for workspace members — root Cargo.lock is canonical.
**/Cargo.lock
!Cargo.lock

# ==============================================================================
# 🍞 JS / Bun / Svelte Frontend Build Artifacts
# ==============================================================================
# Third-party dependency directories (Crucial to ignore!)
node_modules/
jspm_packages/

# Vite production build output
dist/
dist-ssr/

# Log files generated by JS package managers
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*

# TypeScript incremental compilation cache
*.tsbuildinfo

# ==============================================================================
# 🔒 Environment Secrets & Configuration
# ==============================================================================
.env
.env.*
!.env.example

# The platform's single source of configuration truth is `config.toml`.
# Only `config.default.toml` is the template (tracked); runtime `config.toml` is local-only.
config.toml

# ==============================================================================
# 🗄️ Local Databases & Data Directories
# ==============================================================================
# SQLite telemetry files (anywhere in the tree)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-journal
telemetry.db
telemetry.db-shm
telemetry.db-wal

# Docker postgres volume data (if used in future phases)
postgres_data/

# ==============================================================================
# 🖥️ System & Editor Specific Files
# ==============================================================================
# OS Files
.DS_Store
Thumbs.db

# VS Code / IntelliJ settings
.vscode/
.idea/

# Editor temp files
*.swp

# Application Log files
*.log

# Compiled Binary executables/libraries
*.exe
*.dll
*.so
*.dylib

# Engine PID file (written by manage.sh)
.engine.pid

